generator client {
  provider = "prisma-client-js"
  // native = local dev; linux-musl = Docker (Alpine); rhel-openssl-3.0.x = Vercel Functions
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // In production this is Neon's pooled ("-pooler") connection string. Migrations run over the
  // direct connection instead: scripts/vercel-build.cjs swaps in DIRECT_URL for `prisma migrate deploy`.
  url      = env("DATABASE_URL")
}

enum PropertyType {
  Apartment
  Villa
  Plot
  LuxuryHomes
  NewLaunch
  Resale
}

enum ProjectStatus {
  UnderConstruction
  ReadyToMove
  Upcoming
  NewLaunch
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String
  role           String        // ADMIN | EDITOR (legacy compatibility)
  name           String?
  isActive       Boolean       @default(true)
  // Gets an email for every new lead (Admin -> Users, or the switch on Admin -> Leads)
  receivesLeadAlerts Boolean   @default(false)
  lastLoginAt    DateTime?
  userRoles      UserRole[]
  invitesCreated InviteToken[] @relation("InviteCreatedBy")
  assignedLeads  Lead[]        @relation("LeadAssignee")
  leadNotes      LeadNote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  menuAccess      RoleMenuAccess[]
  inviteTokens    InviteToken[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

model MenuItem {
  id         String           @id @default(uuid())
  key        String           @unique
  label      String
  path       String
  icon       String?
  sortOrder  Int              @default(0)
  isEnabled  Boolean          @default(true)
  roleAccess RoleMenuAccess[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model RoleMenuAccess {
  roleId      String
  menuItemId  String
  canView     Boolean  @default(true)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt

  @@id([roleId, menuItemId])
}

model InviteToken {
  id          String    @id @default(uuid())
  token       String    @unique
  email       String
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedById String?
  invitedBy   User?     @relation("InviteCreatedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Builder {
  id              String     @id @default(uuid())
  name            String
  description     String
  experienceYears Int?
  rating          Decimal?   @db.Decimal(3, 2)
  website         String?
  phone           String?
  email           String?
  logoUrl         String?
  heroImageUrl    String?
  properties      Property[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Property {
  id                  String            @id @default(uuid())
  builderId           String
  builder             Builder           @relation(fields: [builderId], references: [id])
  name                String
  slug                String            @unique
  description         String
  addressLine         String?
  city                String
  area                String
  propertyType        PropertyType
  status              ProjectStatus
  isHotProject        Boolean           @default(false)
  priceMin            Decimal?
  priceMax            Decimal?
  currency            String            @default("INR")
  sizeMin             Int?
  sizeMax             Int?
  sizeUnit            String            @default("sqft")
  unitSizeRange       String?
  bedrooms            Int?
  bathrooms           Int?
  totalUnits          Int?
  towersBlocks        String?
  unitVariants        String?
  possessionTime      String?
  completionDate      DateTime?
  lat                 Float?
  lng                 Float?
  mainImageUrl        String
  published           Boolean           @default(true)
  brochureUrl         String?
  // Walkthrough video (YouTube link) and 3D / 360° virtual tour link shown on the project page
  videoUrl            String?
  virtualTourUrl      String?
  reraId              String?
  parkingSpaces       Int?
  furnishing          String?
  facing              String?
  maintenanceFee      Decimal?
  maintenanceCurrency String?           @default("INR")
  launchDate          DateTime?
  tags                String[]
  seoTitle            String?
  seoDescription      String?
  featuredRank        Int?
  views               Int               @default(0)
  saves               Int               @default(0)
  images              PropertyImage[]
  amenities           PropertyAmenity[]
  floorPlans          FloorPlan[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  Lead                Lead[]
  BrochureOtp         BrochureOtp[]
  Wishlist            Wishlist[]

  @@index([city])
  @@index([propertyType])
  @@index([status])
  @@index([isHotProject])
  @@index([createdAt])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  url        String
  altText    String?
  sortOrder  Int?
}

model Amenity {
  id       String            @id @default(uuid())
  name     String            @unique
  code     String?           @unique
  imageUrl String?
  props    PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id])
  amenity    Amenity  @relation(fields: [amenityId], references: [id])

  @@id([propertyId, amenityId])
}

model FloorPlan {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  unitType   String
  size       Int
  unit       String
  price      Decimal
  currency   String   @default("INR")
  imageUrl   String
  bedrooms   Int?
  bathrooms  Int?
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  company   String
  content   String
  rating    Int
  published Boolean  @default(false)
  // Client's photo, shown next to their name
  photoUrl           String?
  // Proof of the testimonial: a scan or photo of a handwritten note or letter (image or PDF)
  attachmentUrl      String?
  attachmentMimeType String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsArticle {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  excerpt        String
  content        String
  imageUrl       String?
  category       String?
  authorName     String?
  sourceUrl      String?
  tags           String[]
  published      Boolean  @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, publishedAt])
  @@index([createdAt])
}

model Subscriber {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  status           String    @default("active") // active|unsubscribed
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
  unsubscribeToken String    @unique
}

/// An email newsletter written in Admin -> Subscribers -> Newsletters and sent to active subscribers.
model Newsletter {
  id             String               @id @default(uuid())
  subject        String
  previewText    String?
  body           String               @default("")
  propertyIds    String[]
  ctaLabel       String?
  ctaUrl         String?
  status         String               @default("draft") // draft|sending|sent
  recipientCount Int                  @default(0)
  sentCount      Int                  @default(0)
  failedCount    Int                  @default(0)
  createdById    String?
  startedAt      DateTime?
  sentAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deliveries     NewsletterDelivery[]

  @@index([createdAt])
}

/// One row per subscriber a newsletter went to, so a send can be resumed without emailing anyone twice.
model NewsletterDelivery {
  id           String     @id @default(uuid())
  newsletterId String
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  subscriberId String
  email        String
  status       String // pending|sent|failed
  error        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([newsletterId, subscriberId])
  @@index([newsletterId, status])
}

model Lead {
  id            String    @id @default(uuid())
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id])
  type          String // site_visit|info|brochure|preference
  name          String
  email         String
  phone         String
  message       String?
  preferredPropertyType String?
  preferredBudgetRange  String?
  preferredLocation     String?
  needsHomeLoanAssistance Boolean?
  sourcePage            String?
  // Where the visitor came from (first visit): utm_source / utm_medium / utm_campaign,
  // plus term, content, gclid, fbclid, referrer and landing page in `attribution`
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  attribution           Json?
  preferredDate DateTime?
  // Pipeline: new, contacted, visit_scheduled, visited, negotiating, booked, lost, invalid (closed = older leads)
  status        String    @default("new")
  assignedToId  String?
  assignedTo    User?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  nextFollowUpAt DateTime?
  notes         LeadNote[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([utmSource])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
  @@index([status])
}

/// Timeline on a lead: notes typed by the team, plus automatic entries for status, owner and follow-up changes.
model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind      String   @default("note") // note | status | assignment | follow_up
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model BrochureOtp {
  id         String    @id @default(uuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  contact    String // phone or email
  ip         String? // requester IP, used for the per-IP rate limit (shared across all server instances)
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([ip, createdAt])
}

/// A home buyer who signed in with their phone number (OTP), so saved projects follow them to any device.
model Buyer {
  id          String    @id @default(uuid())
  /// Digits with country code, e.g. 919876543210
  phone       String    @unique
  name        String?
  email       String?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
}

/// Saved projects. The owner is a signed-in buyer's id or, for visitors without an account,
/// the random id their browser keeps (sent as X-Anon-Id).
model Wishlist {
  anonId     String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@id([anonId, propertyId])
}

model Agent {
  id       String  @id @default(uuid())
  name     String
  phone    String
  email    String?
  photoUrl String?
}

model Neighborhood {
  id          String  @id @default(uuid())
  name        String
  city        String
  description String?
  lat         Float?
  lng         Float?
}

model SiteProfile {
  id          String      @id @default(uuid())
  companyName String
  reraNumber  String?
  tagline     String?
  description String?
  aboutHeroImageUrl String?
  landingHeroImageUrl String?
  projectsHeroImageUrl String?
  buildersHeroImageUrl String?
  newsHeroImageUrl String?
  landingHeroTitlePrefix String?
  landingHeroTitleHighlight String?
  landingHeroDescription String?
  landingHeroStat1Value String?
  landingHeroStat1Label String?
  landingHeroStat2Value String?
  landingHeroStat2Label String?
  landingHeroStat3Value String?
  landingHeroStat3Label String?
  linkedinUrl String?
  facebookUrl String?
  instagramUrl String?
  googleUrl String?
  whatsappNumber String?
  phone       String?
  email       String?
  website     String?
  address     String?
  logoUrl     String?
  headerLogoUrl String?
  // Analytics, set in Admin -> Settings
  ga4MeasurementId String?
  metaPixelId      String?
  executives  Executive[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Executive {
  id            String      @id @default(uuid())
  siteProfileId String
  siteProfile   SiteProfile @relation(fields: [siteProfileId], references: [id], onDelete: Cascade)
  name          String
  role          String
  bio           String?
  imageUrl      String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([siteProfileId])
  @@index([sortOrder])
}

// Uploaded file record (images, brochures, etc.).
// With object storage (Cloudflare R2) the bytes live in the bucket at `storageKey` and `url` is the public URL;
// `data` is only set for files stored in the database (local dev without R2, or legacy rows not yet moved).
model FileAsset {
  id         String   @id @default(uuid())
  filename   String
  mimeType   String
  size       Int
  checksum   String?  // sha256
  data       Bytes?
  storageKey String?
  url        String?
  width     Int?
  height    Int?
  originalId String?
  original   FileAsset? @relation("VariantRelation", fields: [originalId], references: [id])
  variants   FileAsset[] @relation("VariantRelation")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([mimeType])
  @@index([checksum])
  @@index([originalId])
}
