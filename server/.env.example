NODE_ENV=development
PORT=8080

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/estateguide

# JWT
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# CORS
CORS_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=None
COOKIE_SECURE=true

# MSG91
MSG91_AUTH_KEY=replace_me
MSG91_SENDER_ID=ESTATE
MSG91_TEMPLATE_ID=replace_template_id
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_IP_MAX=10
OTP_RATE_IP_WINDOW_SECONDS=600

# Google Cloud Storage
GCS_PUBLIC_BUCKET=estate-guide-public
GCS_PRIVATE_BUCKET=estate-guide-private
SIGNED_URL_TTL_SECONDS=300

# Misc
GIT_COMMIT=dev

# Storage driver: 'gcs' or 'db'. If omitted and buckets invalid, service falls back to db driver.
STORAGE_DRIVER=db
