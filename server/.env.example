NODE_ENV=development
PORT=8080

# Database
# Local: your Docker Postgres. Production (Vercel): Neon's pooled connection string (host contains "-pooler"),
# e.g. postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=postgresql://user:password@localhost:5432/estateguide
# Production only: Neon's direct (non-pooled) connection string, used for migrations during the Vercel build.
# DIRECT_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# CORS
CORS_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=None
COOKIE_SECURE=true

# MSG91
MSG91_AUTH_KEY=replace_me
MSG91_SENDER_ID=ESTATE
MSG91_TEMPLATE_ID=replace_template_id
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_IP_MAX=10
OTP_RATE_IP_WINDOW_SECONDS=600

# Cloudflare R2 (file uploads). Leave unset locally to keep storing uploads in the database.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=replace_me
# R2_SECRET_ACCESS_KEY=replace_me
# R2_BUCKET=estate-guide-files
# R2_PUBLIC_URL=https://files.yourhomesearch.co.in
# MAX_UPLOAD_MB=25

# Google Cloud Storage (legacy; only used by the old property image presign endpoints)
# GCS_PUBLIC_BUCKET=estate-guide-public
# GCS_PRIVATE_BUCKET=estate-guide-private
SIGNED_URL_TTL_SECONDS=300

# Email (Brevo): admin invites and new-lead alerts
# BREVO_API_KEY=replace_me
# MAIL_FROM_EMAIL=no-reply@yourhomesearch.co.in   (falls back to INVITE_FROM_EMAIL)
# MAIL_FROM_NAME=YourHomeSearch
# Who gets an email for every new lead (comma-separated). Leave empty to turn alerts off.
# LEAD_ALERT_EMAILS=sales@yourhomesearch.co.in,rahul@example.com
# Optional: only alert for some lead types (site_visit,info,brochure,preference). Default: all.
# LEAD_ALERT_TYPES=site_visit,info,preference

# Misc
GIT_COMMIT=dev

# Uploads go to R2 when the R2_* variables above are set, otherwise to the database.
