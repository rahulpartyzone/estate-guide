{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "strict": true,
    "skipLibCheck": true,
  "types": ["node", "jest"],
    "esModuleInterop": true
  },
  "include": ["src/**/*", "nest-cli.json"],
  "exclude": ["node_modules", "dist"]
}
