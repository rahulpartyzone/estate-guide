{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/seo.js": { "includeFiles": "dist/index.html", "maxDuration": 10 },
    "api/sitemap.js": { "maxDuration": 20 },
    "api/robots.js": { "maxDuration": 5 }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://estate-guide-nine.vercel.app/api/v1/:path*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/project/:id", "destination": "/api/seo?path=/project/:id" },
    { "source": "/builders/:id", "destination": "/api/seo?path=/builders/:id" },
    { "source": "/projects", "destination": "/api/seo?path=/projects" },
    { "source": "/builders", "destination": "/api/seo?path=/builders" },
    { "source": "/news", "destination": "/api/seo?path=/news" },
    { "source": "/about", "destination": "/api/seo?path=/about" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
